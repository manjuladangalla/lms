# LMS production reverse proxy (Caddy)
#
#   {$DOMAIN}   -> real Let's Encrypt certificate (set DOMAIN=yourdomain.com in .env)
#   any other host, and the bare droplet IP -> internal self-signed certificate
#   plain HTTP  -> always redirected to HTTPS
#
# The frontend is built with the relative API url /api/v1, so the app works on any
# domain or IP without rebuilding.

(lms_handlers) {
	encode gzip

	@api path /api /api/* /media /media/* /health

	handle @api {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy web:80
	}
}

https://{$DOMAIN} {
	import lms_handlers
}

# Everything else (droplet IP, unknown hostnames): internal certificate.
# on_demand so a certificate is issued for whichever SNI the client sends;
# connections without SNI (browsers typing the IP) use the default certificate.
:443 {
	tls {
		issuer internal
		on_demand
	}
	import lms_handlers
}

:80 {
	redir https://{http.request.host}{uri} permanent
}
