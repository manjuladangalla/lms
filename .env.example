# --- App ---
# DEBUG=true is development only: registration OTP codes come back in the API
# response and errors are returned verbatim. Set false in production.
DEBUG=true
MONGO_DB=lms
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080,http://localhost

# --- Production (docker-compose.prod.yml, Caddy HTTPS) ---
# Domain used for the Let's Encrypt certificate. Leave as localhost to serve the
# droplet IP over HTTPS with a self-signed certificate; set yourdomain.com for a
# trusted certificate. Only docker-compose.prod.yml reads this.
DOMAIN=localhost

# --- File storage (backend: local | s3 — also editable by super admin at System) ---
# local: files saved to UPLOAD_DIR and served at /media/*
UPLOAD_DIR=uploads
# optional absolute base for local media URLs (empty = relative /media/...)
PUBLIC_API_URL=
# s3: works with AWS S3, Cloudflare R2, MinIO, etc.
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=lms-media
S3_REGION=auto
S3_PUBLIC_URL=

# --- Security (CHANGE IN PRODUCTION) ---
JWT_SECRET=change-me-to-a-long-random-string

# --- Email OTP (student registration 2FA) ---
# Without SMTP, set DEBUG=true to receive the code in the API response (dev only)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
OTP_TTL_SECONDS=600

# --- Google OAuth (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- PayPal (optional: sandbox | live) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=

# --- Zoom live classes (optional) ---
# Zoom App Marketplace → Develop → Build App → Server-to-Server OAuth
# Scopes: meeting:write:admin, meeting:read:admin, user:read:admin
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Host user email on your Zoom account (optional; first user used if empty)
ZOOM_HOST_EMAIL=

DEFAULT_CURRENCY=USD

# --- Frontend ---
# Dev server / dev docker-compose.yml. Production always builds with /api/v1
# (same origin behind Caddy), so this value is ignored there.
VITE_API_URL=http://localhost:8000/api/v1
